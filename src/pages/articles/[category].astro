---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import VideoCard from '../../components/VideoCard.astro';
import { CATEGORIES, getCategoryParent, getCategoryScope, slugifyCategory, type Category } from '../../lib/utils';

export function getStaticPaths() {
	return CATEGORIES.map((category) => ({
		params: { category: slugifyCategory(category) },
		props: { category },
	}));
}

const { category } = Astro.props as { category: Category };
const parentCategory = getCategoryParent(category);
const categoryScope = getCategoryScope(category);
const articles = (await getCollection('articles'))
	.filter((article) => article.data.published && categoryScope.includes(article.data.category))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const videos = (await getCollection('videos'))
	.filter((video) => video.data.published && categoryScope.includes(video.data.category))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 4);
---

<BaseLayout title={category} description={`Articles Travel-Îles — ${category}.`}>
	<section class="container-wide listing-page">
		<header class="listing-header">
			{parentCategory ? (
				<div class="category-context">
					<a href={`/articles/${slugifyCategory(parentCategory)}`}>{parentCategory}</a>
					<span aria-hidden="true">/</span>
					<span>Sous-rubrique</span>
				</div>
			) : (
				<span class="kicker">Rubrique</span>
			)}
			<h1 class="page-title">{category}</h1>
		</header>

		<CategoryNav active={category} />

		{category === 'Nos archives' ? (
			<section class="listing-section listing-section--intro">
				<div class="archives-intro">
					<p>Depuis avril 1994, Côte Nord Magazine raconte l'île Maurice à travers ses lieux, ses visages, ses initiatives et celles et ceux qui participent à son évolution. Au fil des années, ses pages ont accompagné les transformations du tourisme, de l'hôtellerie, de la gastronomie, de la culture et de la société mauricienne, tout en mettant en lumière des histoires, des métiers et des personnalités parfois oubliés.</p>
					<p>À travers cette rubrique, Travel-Îles ouvre aujourd'hui ses archives et vous invite à redécouvrir régulièrement une sélection d'articles parus depuis le tout premier numéro. Témoins de leur époque, ces textes et ces images offrent un regard singulier sur Maurice, ses évolutions, ses ambitions et son art de vivre, avec un horizon qui s'étend souvent au-delà de ses frontières, vers les îles et les destinations de l'océan Indien.</p>
					<p>Plus de trente ans plus tard, certains sujets résonnent encore avec une étonnante modernité&nbsp;; d'autres nous rappellent combien l'île a changé. Ensemble, ils composent une mémoire vivante de Maurice et de son histoire touristique et humaine.</p>
				</div>
			</section>
		) : (
			<section class="listing-section">
				<h2 class="subsection-title">Nos dernières vidéos</h2>
				{videos.length > 0 ? (
					<div class="grid-4">
						{videos.map((video) => <VideoCard video={video} />)}
					</div>
				) : (
					<p class="empty-state empty-state--compact">
						Aucune vidéo dans cette rubrique pour le moment.
					</p>
				)}
			</section>
		)}

		<section class="listing-section">
			<h2 class="subsection-title">Articles</h2>
			{articles.length > 0 ? (
				<div class="grid-3">
					{articles.map((article) => <ArticleCard article={article} />)}
				</div>
			) : (
				<p class="empty-state">
					Aucun sujet dans cette rubrique pour le moment.
				</p>
			)}
		</section>
	</section>
</BaseLayout>

<style>
	.listing-page {
		padding-top: var(--space-12);
		padding-bottom: var(--space-16);
	}

	.listing-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-bottom: var(--space-8);
		border-bottom: 1px solid var(--border-strong);
		margin-bottom: var(--space-8);
	}

	.listing-header .page-title {
		font-size: clamp(2rem, 5vw, 3.5rem);
	}

	.category-context {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.category-context a {
		color: var(--navy);
	}

	.listing-section {
		padding-top: var(--space-12);
	}

	.listing-section + .listing-section {
		margin-top: var(--space-12);
		padding-top: var(--space-12);
		border-top: 1px solid var(--border-subtle);
	}

	.subsection-title {
		margin-bottom: var(--space-8);
		font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
	}

	.empty-state {
		text-align: center;
		color: var(--text-muted);
		font-size: var(--text-lg);
		padding: var(--space-16) 0;
	}

	.empty-state--compact {
		padding: var(--space-8) 0;
	}

	.listing-section--intro {
		padding-top: var(--space-8);
	}

	.archives-intro {
		max-width: 72ch;
	}

	.archives-intro p {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--text-muted);
		margin-bottom: var(--space-5);
	}

	.archives-intro p:last-child {
		margin-bottom: 0;
	}
</style>
