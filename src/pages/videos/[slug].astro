---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryLabel from '../../components/CategoryLabel.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import VideoCard from '../../components/VideoCard.astro';
import AdPlacement from '../../components/AdPlacement.astro';
import { formatDate } from '../../lib/utils';
import { iconSvg } from '../../lib/icons';
import { getVideoThumbnail } from '../../lib/video';

export async function getStaticPaths() {
	const videos = (await getCollection('videos')).filter((video) => video.data.published);
	const enVideos = await getCollection('videos_en');
	return videos.map((video) => ({
		params: { slug: video.id },
		props: { video, hasEn: enVideos.some((entry) => entry.id === video.id && entry.data.published && !!entry.data.title) },
	}));
}

const { video, hasEn } = Astro.props;
const { Content } = await render(video);
const alternateUrl = hasEn ? `/en/videos/${video.id}` : undefined;
const displayThumbnail = getVideoThumbnail(video.data.videoSource, video.data.videoId, video.data.thumbnail);

const videoSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: video.data.title,
	description: video.data.excerpt,
	uploadDate: video.data.date.toISOString(),
	...(displayThumbnail ? { thumbnailUrl: displayThumbnail.startsWith('http') ? displayThumbnail : new URL(displayThumbnail, Astro.site).href } : {}),
	url: new URL(Astro.url.pathname, Astro.site).href,
});

const allVideos = (await getCollection('videos'))
	.filter((v) => v.data.published && v.id !== video.id)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const more = allVideos.slice(0, 6);
---

<BaseLayout title={video.data.title} description={video.data.excerpt} ogImage={displayThumbnail} locale="fr" alternateUrl={alternateUrl}>
	<script type="application/ld+json" set:html={videoSchema} />
	<div class="video-page">
		<!-- Back link -->
		<div class="back-wrap">
			<a class="back-link" href="/videos">
				<span class="back-arrow"><Fragment set:html={iconSvg('arrow-right', 16)} /></span>
				Toutes les vidéos
			</a>
		</div>

		<!-- Centered title block above player -->
		<header class="video-header">
			<div class="video-header-top">
				<CategoryLabel category={video.data.category} variant="solid" linked={false} />
				<span class="meta video-meta-type">Vidéo · {formatDate(video.data.date)}</span>
			</div>
			<h1>{video.data.title}</h1>
		</header>

		<!-- Player — prominent 16:9 -->
		<div class="video-player">
			<VideoEmbed videoSource={video.data.videoSource} videoId={video.data.videoId} videoFile={video.data.videoFile} thumbnail={video.data.thumbnail} title={video.data.title} />
		</div>

		<!-- Description — centered reading measure -->
		<div class="video-desc">
			<p class="video-excerpt">{video.data.excerpt}</p>
			<div class="prose video-body">
				<Content />
			</div>
			<div class="video-meta-footer meta">
				<span class="video-brand">Travel-Îles</span>
				<span aria-hidden="true">·</span>
				<span>{formatDate(video.data.date)}</span>
			</div>
		</div>
	</div>

	{inlineAd && <AdPlacement ad={inlineAd} locale="fr" compact />}

	{more.length > 0 && (
		<section class="container-wide section more-section" data-more-videos>
			<div class="section-header more-header">
				<h2 class="section-title more-title">À voir aussi</h2>
				<div class="more-controls" aria-label="Navigation des vidéos">
					<button class="more-arrow more-arrow--prev" type="button" aria-label="Vidéos précédentes" disabled>
						<span><Fragment set:html={iconSvg('chevron-right', 22)} /></span>
					</button>
					<button class="more-arrow more-arrow--next" type="button" aria-label="Vidéos suivantes">
						<Fragment set:html={iconSvg('chevron-right', 22)} />
					</button>
				</div>
			</div>
			<div class="more-carousel" tabindex="0" aria-label="Vidéos à voir aussi">
				{more.map((v) => <div class="more-slide"><VideoCard video={v} /></div>)}
			</div>
		</section>
	)}
</BaseLayout>

<script>
	function initMoreVideos() {
		document.querySelectorAll<HTMLElement>('[data-more-videos]').forEach((section) => {
			if (section.dataset.carouselReady === 'true') return;
			section.dataset.carouselReady = 'true';

			const carousel = section.querySelector<HTMLElement>('.more-carousel');
			const previous = section.querySelector<HTMLButtonElement>('.more-arrow--prev');
			const next = section.querySelector<HTMLButtonElement>('.more-arrow--next');
			if (!carousel || !previous || !next) return;

			function updateArrows() {
				const maxScroll = Math.max(0, carousel!.scrollWidth - carousel!.clientWidth);
				previous!.disabled = carousel!.scrollLeft <= 2;
				next!.disabled = carousel!.scrollLeft >= maxScroll - 2;
			}

			function scrollByCard(direction: -1 | 1) {
				const slides = carousel!.querySelectorAll<HTMLElement>('.more-slide');
				const distance = slides.length > 1
					? slides[1].offsetLeft - slides[0].offsetLeft
					: carousel!.clientWidth;
				carousel!.scrollBy({ left: direction * distance, behavior: 'smooth' });
			}

			previous.addEventListener('click', () => scrollByCard(-1));
			next.addEventListener('click', () => scrollByCard(1));
			carousel.addEventListener('scroll', updateArrows, { passive: true });
			carousel.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') scrollByCard(-1);
				if (event.key === 'ArrowRight') scrollByCard(1);
			});
			window.addEventListener('resize', updateArrows);
			requestAnimationFrame(updateArrows);
		});
	}

	document.addEventListener('astro:page-load', initMoreVideos);
	initMoreVideos();
</script>

<style>
	.video-page {
		width: min(100% - 2.5rem, 62rem);
		margin: 0 auto;
		padding-top: var(--space-8);
	}

	.back-wrap {
		margin-bottom: var(--space-2);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: var(--text-muted);
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		margin-bottom: var(--space-8);
	}

	.back-arrow {
		display: inline-flex;
		transform: rotate(180deg);
	}

	/* Title block — left-aligned, editorial */
	.video-header {
		text-align: left;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		margin-bottom: var(--space-8);
		padding-top: var(--space-4);
	}

	.video-header-top {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.video-meta-type {
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		color: var(--text-muted);
	}

	h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
		line-height: 1.06;
		text-wrap: balance;
		margin: 0;
		letter-spacing: -0.01em;
	}

	/* Player */
	.video-player {
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--navy-950);
		box-shadow: var(--shadow-lg);
	}

	/* Description — left-aligned, reading measure */
	.video-desc {
		width: min(100%, var(--editorial-width));
		margin: 0;
		padding-top: var(--space-10);
		padding-bottom: var(--space-12);
	}

	.video-excerpt {
		font-family: var(--font-display);
		font-weight: var(--fw-regular);
		font-size: clamp(1.25rem, 2.2vw, 1.5rem);
		line-height: 1.5;
		color: var(--ink);
		margin: 0;
	}

	.video-body {
		max-width: none;
		margin-top: var(--space-6);
		color: var(--text-body);
	}

	.video-meta-footer {
		display: flex;
		gap: var(--space-3);
		align-items: center;
		margin-top: var(--space-8);
		padding-top: var(--space-5);
		border-top: 1px solid var(--border-subtle);
	}

	.video-brand {
		color: var(--ink);
		font-weight: var(--fw-medium);
	}

	.more-title {
		font-size: var(--text-2xl);
	}

	.more-controls {
		display: none;
		align-items: center;
		gap: var(--space-2);
	}

	.more-arrow {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-pill);
		background: var(--surface-page);
		color: var(--text-heading);
		cursor: pointer;
		transition: opacity var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}

	.more-arrow--prev span {
		display: block;
		transform: rotate(180deg);
	}

	.more-arrow:disabled {
		opacity: 0.3;
		cursor: default;
	}

	.more-carousel {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-8);
	}

	@media (max-width: 640px) {
		.more-header {
			display: flex;
			align-items: center;
		}

		.more-controls {
			display: flex;
		}

		.more-carousel {
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 84%;
			gap: var(--space-4);
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
			overscroll-behavior-inline: contain;
			-webkit-overflow-scrolling: touch;
		}

		.more-carousel::-webkit-scrollbar {
			display: none;
		}

		.more-slide {
			scroll-snap-align: start;
		}
	}
</style>
