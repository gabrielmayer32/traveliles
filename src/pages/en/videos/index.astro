---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import VideoCard from '../../../components/VideoCard.astro';
import AdPlacement from '../../../components/AdPlacement.astro';
import { t } from '../../../lib/i18n';

const locale = 'en' as const;
const videos = (await getCollection('videos_en'))
	.filter((video) => video.data.published && !!video.data.title)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const inlineAd = (await getCollection('ads')).find((ad) => ad.data.visible && ad.data.placement === 'inline' && ad.data.showOnListings);
---

<BaseLayout title="Videos" description="All videos from Travel-Îles." locale={locale} alternateUrl="/videos">
	<section class="container-wide listing-page">
		<header class="listing-header">
			<span class="kicker">The video magazine</span>
			<h1 class="page-title">Videos</h1>
		</header>

		<CategoryNav mode="filters" locale={locale} />

		<div class="grid-3 listing-grid" id="listing-grid">
			{videos.slice(0, 6).map((video) => (
				<div class="listing-item" data-cat={video.data.category}>
					<VideoCard video={video} locale={locale} />
				</div>
			))}
		</div>
		{inlineAd && <AdPlacement ad={inlineAd} locale={locale} />}
		{videos.length > 6 && <div class="grid-3 listing-grid">
			{videos.slice(6).map((video) => <div class="listing-item" data-cat={video.data.category}><VideoCard video={video} locale={locale} /></div>)}
		</div>}

		{videos.length === 0 && (
			<p class="empty-state">{t('listing.empty', locale)}</p>
		)}
		<p class="empty-state" id="empty-state" hidden>{t('listing.empty', locale)}</p>
	</section>
</BaseLayout>

<script>
	const chips = document.querySelectorAll<HTMLElement>('.chip');
	const items = document.querySelectorAll<HTMLElement>('.listing-item');
	const emptyState = document.getElementById('empty-state');

	chips.forEach((chip) => {
		chip.addEventListener('click', (event) => {
			event.preventDefault();
			const categories = (chip.dataset.categories ?? '').split('|');

			chips.forEach((item) => item.classList.remove('chip--active'));
			chip.classList.add('chip--active');

			let visible = 0;
			items.forEach((item) => {
				const show = categories.includes('all') || categories.includes(item.dataset.cat ?? '');
				item.hidden = !show;
				if (show) visible++;
			});

			if (emptyState) emptyState.hidden = visible > 0;
		});
	});
</script>

<style>
	.listing-page {
		padding-top: var(--space-12);
		padding-bottom: var(--space-16);
	}

	.listing-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-bottom: var(--space-8);
		border-bottom: 1px solid var(--border-strong);
		margin-bottom: var(--space-8);
	}

	.listing-header .page-title {
		font-size: clamp(2rem, 5vw, 3.5rem);
	}

	.listing-grid {
		min-height: 200px;
	}

	.listing-item[hidden] {
		display: none;
	}

	.empty-state {
		text-align: center;
		color: var(--text-muted);
		font-size: var(--text-lg);
		padding: var(--space-16) 0;
	}
</style>
