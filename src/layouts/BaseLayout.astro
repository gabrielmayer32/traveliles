---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AdPlacement from '../components/AdPlacement.astro';
import type { Locale } from '../lib/i18n';
import { isAdLive } from '../lib/utils';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	locale?: Locale;
	alternateUrl?: string;
}

const {
	title,
	description = "Travel-Îles — voyages, saveurs, cultures et adresses à Maurice et dans les îles de l'océan Indien.",
	ogImage = '/images/uploads/cote-nord-og.jpg',
	locale = 'fr',
	alternateUrl,
} = Astro.props;

const pageTitle = title ? `${title} — Travel-Îles` : 'Travel-Îles';
// Facebook et X ignorent les og:image relatives : il faut une URL absolue.
const ogImageUrl = new URL(ogImage || '/images/uploads/cote-nord-og.jpg', Astro.site).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const altUrl = alternateUrl ? new URL(alternateUrl, Astro.site).href : undefined;
const xDefaultUrl = locale === 'fr' ? canonicalUrl : (altUrl ?? canonicalUrl);
const siteUrl = new URL('/', Astro.site).href;
const orgSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'NewsMediaOrganization',
			'@id': `${siteUrl}#organization`,
			name: 'Travel-Îles',
			alternateName: ['Travel Iles', 'Travel-Iles', 'TravelIles', 'Côte Nord Magazine'],
			url: siteUrl,
			logo: new URL('/images/logo-travel-iles.png', Astro.site).href,
			description:
				"Travel-Îles est un magazine éditorial indépendant de l'île Maurice, héritier du magazine Côte Nord. Il raconte en vidéos et en articles les voyages, la gastronomie, la culture, les régions et l'art de vivre de Maurice et de l'océan Indien. Ce n'est pas une agence de voyages.",
			areaServed: { '@type': 'Country', name: 'Mauritius' },
			knowsLanguage: ['fr', 'en'],
			sameAs: ['https://www.youtube.com/@TravelIles', 'https://www.facebook.com/traveliles'],
		},
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}#website`,
			name: 'Travel-Îles',
			url: siteUrl,
			inLanguage: ['fr', 'en'],
			publisher: { '@id': `${siteUrl}#organization` },
		},
	],
});
const globalAds =(await getCollection('ads')).filter((ad) => isAdLive(ad) && ['sidebar', 'floating', 'popup'].includes(ad.data.placement));
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'fr_FR'} />
		<meta property="article:publisher" content="https://www.facebook.com/traveliles" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang={locale} href={canonicalUrl} />
		{altUrl && <link rel="alternate" hreflang={locale === 'fr' ? 'en' : 'fr'} href={altUrl} />}
		<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
		{ogImage && <link rel="preload" as="image" href={ogImageUrl} />}
		<link rel="alternate" type="application/rss+xml" title="Travel-Îles" href={new URL(locale === 'en' ? '/en/rss.xml' : '/rss.xml', Astro.site).href} />
		<script type="application/ld+json" set:html={orgSchema} />
		<ClientRouter />
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-F00X8JTGKK"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-F00X8JTGKK');
		</script>
	</head>
	<body>
		<Header locale={locale} alternateUrl={alternateUrl} />
		<main>
			<slot />
		</main>
		<Footer locale={locale} />
		{globalAds.map((ad) => <AdPlacement ad={ad} locale={locale} />)}
		<CookieBanner locale={locale} />
	</body>
</html>
