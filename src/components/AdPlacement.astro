---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
	ad: CollectionEntry<'ads'>;
	locale?: Locale;
	compact?: boolean;
}

const { ad, locale = 'fr', compact = false } = Astro.props;
const { image, url, placement, label } = ad.data;
const title = locale === 'en' ? (ad.data.titleEn || ad.data.title) : ad.data.title;
const cta = locale === 'en' ? (ad.data.ctaEn || ad.data.cta) : ad.data.cta;
const isDismissible = placement === 'floating' || placement === 'popup';
---

{placement === 'popup' ? (
	<div class="ad-popup" data-ad-id={ad.id} hidden>
		<div class="ad-popup-backdrop" data-ad-close></div>
		<aside class="ad ad--popup" role="dialog" aria-modal="true" aria-label={`${label} : ${title}`}>
			<button class="ad-close" type="button" aria-label={locale === 'en' ? 'Close ad' : 'Fermer la publicité'} data-ad-close>×</button>
			<a class="ad-link" href={url || undefined} target={url ? '_blank' : undefined} rel={url ? 'sponsored noopener' : undefined}>
				{image && <img class="ad-image" src={image} alt="" loading="eager" />}
				<div class="ad-copy"><span class="ad-label">{label}</span><strong class="ad-title">{title}</strong>{cta && <span class="ad-cta">{cta}<span aria-hidden="true"> →</span></span>}</div>
			</a>
		</aside>
	</div>
) : (
	<aside class:list={['ad', `ad--${placement}`, compact && 'ad--compact']} data-ad-id={ad.id} aria-label={`${label} : ${title}`}>
		{isDismissible && <button class="ad-close" type="button" aria-label={locale === 'en' ? 'Close ad' : 'Fermer la publicité'} data-ad-close>×</button>}
		<a class="ad-link" href={url || undefined} target={url ? '_blank' : undefined} rel={url ? 'sponsored noopener' : undefined}>
			{image && <img class="ad-image" src={image} alt="" loading="lazy" />}
			<div class="ad-copy"><span class="ad-label">{label}</span><strong class="ad-title">{title}</strong>{cta && <span class="ad-cta">{cta}<span aria-hidden="true"> →</span></span>}</div>
		</a>
	</aside>
)}

<style>
	.ad {
		position: relative;
		background: var(--surface-card);
		border: var(--border-hairline);
		box-shadow: var(--shadow-card);
		overflow: hidden;
	}
	.ad-link { display: flex; color: inherit; }
	.ad-image { object-fit: cover; }
	.ad-copy { display: flex; flex-direction: column; justify-content: center; gap: var(--space-2); padding: var(--space-5); min-width: 0; }
	.ad-label { color: var(--text-muted); font-size: var(--text-2xs); font-weight: var(--fw-semibold); letter-spacing: var(--tracking-wider); text-transform: uppercase; }
	.ad-title { color: var(--text-heading); font-family: var(--font-display); font-size: var(--text-lg); font-weight: var(--fw-medium); line-height: var(--leading-snug); }
	.ad-cta { color: var(--text-brand); font-size: var(--text-xs); font-weight: var(--fw-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
	.ad-close { position: absolute; z-index: 2; top: var(--space-2); right: var(--space-2); display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 1px solid var(--border-subtle); border-radius: var(--radius-pill); background: var(--surface-card); color: var(--text-heading); font-size: var(--text-xl); line-height: 1; cursor: pointer; box-shadow: var(--shadow-sm); }
	.ad-close:hover { background: var(--navy); color: var(--white); }

	.ad--sidebar { position: fixed; z-index: 80; top: calc(var(--header-height) + var(--space-8)); right: var(--space-4); width: clamp(190px, calc((100vw - var(--max-width-wide)) / 2 - (2 * var(--space-4))), 280px); max-height: calc(100dvh - var(--header-height) - (2 * var(--space-8))); }
	.ad--sidebar .ad-link { flex-direction: column; }
	.ad--sidebar .ad-image { width: 100%; aspect-ratio: 1 / 1; }
	.ad--sidebar .ad-copy { padding: var(--space-4); }
	.ad--sidebar .ad-title { font-size: var(--text-base); }

	.ad--inline { width: min(100% - (2 * var(--gutter)), var(--max-width-wide)); margin: var(--space-4) auto var(--space-10); }
	.ad--inline .ad-link { min-height: 180px; }
	.ad--inline .ad-image { width: 42%; max-width: 520px; }
	.ad--inline .ad-copy { padding-inline: clamp(var(--space-6), 5vw, var(--space-16)); }
	.ad--inline .ad-title { font-size: clamp(var(--text-xl), 3vw, var(--text-3xl)); }
	.ad--inline.ad--compact { width: min(100% - (2 * var(--gutter)), 62rem); margin-block: var(--space-8); }
	.ad--inline.ad--compact .ad-link { min-height: 124px; }
	.ad--inline.ad--compact .ad-image { width: 32%; max-width: 280px; }
	.ad--inline.ad--compact .ad-copy { padding: var(--space-5) var(--space-8); }
	.ad--inline.ad--compact .ad-title { font-size: clamp(var(--text-lg), 2vw, var(--text-xl)); }

	.ad--floating { position: fixed; z-index: 90; left: 50%; bottom: var(--space-4); width: min(calc(100% - (2 * var(--gutter))), 760px); transform: translateX(-50%); box-shadow: var(--shadow-lg); }
	.ad--floating .ad-link { min-height: 116px; padding-right: var(--space-10); }
	.ad--floating .ad-image { width: 180px; }

	.ad-popup { position: fixed; z-index: 110; inset: 0; display: grid; place-items: center; padding: var(--gutter); }
	.ad-popup[hidden] { display: none; }
	.ad-popup-backdrop { position: absolute; inset: 0; background: var(--scrim-navy); }
	.ad--popup { width: min(100%, 640px); box-shadow: var(--shadow-lg); }
	.ad--popup .ad-link { flex-direction: column; }
	.ad--popup .ad-image { width: 100%; max-height: 360px; }
	.ad--popup .ad-copy { padding: var(--space-8); }
	.ad--popup .ad-title { font-size: var(--text-2xl); }

	@media (max-width: 1800px) {
		.ad--sidebar { display: none; }
	}
	@media (max-width: 640px) {
		.ad--inline .ad-link, .ad--floating .ad-link { min-height: 0; }
		.ad--inline .ad-image, .ad--floating .ad-image { width: 36%; }
		.ad-copy { padding: var(--space-4); }
		.ad-title { font-size: var(--text-base); }
		.ad--inline .ad-title { font-size: var(--text-lg); }
		.ad--inline.ad--compact .ad-copy { padding: var(--space-4); }
		.ad--inline.ad--compact .ad-title { font-size: var(--text-base); }
		.ad--floating { bottom: var(--space-2); }
		.ad--floating .ad-link { padding-right: var(--space-8); }
		.ad--popup .ad-copy { padding: var(--space-6); }
	}
</style>

{isDismissible && (
	<script>
		function setupDismissibleAds() {
			document.querySelectorAll<HTMLElement>('[data-ad-id]').forEach((ad) => {
				if (ad.dataset.adReady) return;
				ad.dataset.adReady = 'true';
				const key = `ti-ad-${ad.dataset.adId}`;
				if (sessionStorage.getItem(key) === 'closed') { ad.hidden = true; return; }
				if (ad.classList.contains('ad-popup')) window.setTimeout(() => { ad.hidden = false; }, 650);
				ad.querySelectorAll('[data-ad-close]').forEach((button) => button.addEventListener('click', () => {
					sessionStorage.setItem(key, 'closed');
					ad.hidden = true;
				}));
			});
		}
		document.addEventListener('astro:page-load', setupDismissibleAds);
		setupDismissibleAds();
	</script>
)}
