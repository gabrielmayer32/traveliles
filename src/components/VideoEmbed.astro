---
import { t, type Locale } from '../lib/i18n';
import { getVideoThumbnail, getYouTubeThumbnailFallback, getYouTubeVideoId } from '../lib/video';

interface Props {
	videoSource: 'youtube' | 'vimeo' | 'facebook' | 'instagram' | 'r2';
	videoId?: string;
	videoFile?: string;
	title?: string;
	thumbnail?: string;
	locale?: Locale;
}

const { videoSource, videoId, videoFile, title = 'Vidéo Travel-Îles', thumbnail, locale = 'fr' } = Astro.props;

const isR2 = videoSource === 'r2';
const embedVideoId = videoSource === 'youtube' ? getYouTubeVideoId(videoId) : videoId;
const displayThumbnail = getVideoThumbnail(videoSource, videoId, thumbnail);
const thumbnailFallback = !thumbnail && videoSource === 'youtube'
	? getYouTubeThumbnailFallback(videoId)
	: undefined;

const src = isR2 ? undefined : {
	youtube: `https://www.youtube.com/embed/${embedVideoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`,
	vimeo: `https://player.vimeo.com/video/${embedVideoId}?autoplay=1&title=0&byline=0&portrait=0`,
	facebook: `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(embedVideoId ?? '')}&autoplay=true`,
	instagram: `https://www.instagram.com/reel/${embedVideoId}/embed/`,
}[videoSource as 'youtube' | 'vimeo' | 'facebook' | 'instagram'];

const platformName = { youtube: 'YouTube', vimeo: 'Vimeo', facebook: 'Facebook', instagram: 'Instagram' }[videoSource as string] ?? videoSource;

const directUrl = isR2 ? undefined : {
	youtube: `https://www.youtube.com/watch?v=${embedVideoId}`,
	vimeo: `https://vimeo.com/${embedVideoId}`,
	facebook: embedVideoId,
	instagram: `https://www.instagram.com/reel/${embedVideoId}/`,
}[videoSource as 'youtube' | 'vimeo' | 'facebook' | 'instagram'];
---

{isR2 && videoFile ? (
	<div class="video-embed video-embed--r2">
		<video
			src={videoFile}
			controls
			playsinline
			preload="metadata"
			poster={displayThumbnail}
			style="display:block;width:100%;height:100%;background:#000"
		>
			<p>{locale === 'en' ? 'Your browser does not support video playback.' : 'Votre navigateur ne supporte pas la lecture vidéo.'}</p>
		</video>
	</div>
) : (
	<div
		class="video-embed"
		data-embed-src={src}
		data-embed-title={title}
		data-play-label={locale === 'en' ? 'Play video' : 'Lire la vidéo'}
	>
		{displayThumbnail && (
			<img
				class="video-embed-poster"
				src={displayThumbnail}
				data-fallback-src={thumbnailFallback}
				alt=""
				aria-hidden="true"
			/>
		)}
		<div class="video-embed-placeholder">
			<p>{t('video.hosted_by', locale)} ({platformName}).</p>
			<button class="video-embed-accept" type="button">{t('video.accept_cookies', locale)}</button>
			{directUrl && (
				<a class="video-embed-external" href={directUrl} target="_blank" rel="noopener">
					{t('video.watch_on', locale)} {platformName} ↗
				</a>
			)}
		</div>
	</div>
)}

<script>
	function initVideoEmbeds() {
		document.querySelectorAll<HTMLElement>('.video-embed:not(.video-embed--r2)').forEach((el) => {
			if (el.dataset.embedReady === 'true') return;
			el.dataset.embedReady = 'true';

			const src = el.dataset.embedSrc;
			const title = el.dataset.embedTitle || 'Vidéo';
			const placeholder = el.querySelector<HTMLElement>('.video-embed-placeholder');
			const poster = el.querySelector<HTMLImageElement>('.video-embed-poster');
			const acceptBtn = el.querySelector<HTMLButtonElement>('.video-embed-accept');

			if (poster?.dataset.fallbackSrc) {
				poster.addEventListener('error', () => {
					if (poster.src !== poster.dataset.fallbackSrc) {
						poster.src = poster.dataset.fallbackSrc || '';
					}
				}, { once: true });
			}

			function loadIframe() {
				if (!src || !placeholder) return;
				placeholder.classList.add('is-loading');
				const iframe = document.createElement('iframe');
				iframe.src = src;
				iframe.title = title;
				iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
				iframe.allowFullscreen = true;
				iframe.style.cssText = 'position:absolute;inset:0;display:block;width:100%;height:100%;border:0;opacity:0';
				iframe.addEventListener('load', () => {
					iframe.style.opacity = '1';
					placeholder.remove();
					poster?.remove();
				}, { once: true });
				el.appendChild(iframe);
			}

			const enablePlayButton = () => {
				if (!acceptBtn) return;
				acceptBtn.textContent = el.dataset.playLabel || 'Lire la vidéo';
				acceptBtn.addEventListener('click', loadIframe, { once: true });
			};

			if (localStorage.getItem('ti-cookies') === 'accepted') {
				enablePlayButton();
			} else {
				const acceptAndLoad = () => {
					localStorage.setItem('ti-cookies', 'accepted');
					document.getElementById('cookie-banner')?.setAttribute('hidden', '');
					loadIframe();
				};
				acceptBtn?.addEventListener('click', acceptAndLoad, { once: true });

				document.addEventListener('ti:cookies-accepted', () => {
					acceptBtn?.removeEventListener('click', acceptAndLoad);
					enablePlayButton();
				}, { once: true });
			}
		});
	}

	document.addEventListener('astro:page-load', initVideoEmbeds);
	initVideoEmbeds();
</script>

<style>
	.video-embed {
		position: relative;
		aspect-ratio: 16 / 9;
		width: 100%;
		background: var(--navy-950);
		overflow: hidden;
	}

	.video-embed-poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.video-embed-placeholder {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-4);
		height: 100%;
		padding: var(--space-6);
		text-align: center;
		color: rgba(255, 255, 255, 0.7);
		font-size: var(--text-sm);
	}

	.video-embed-placeholder.is-loading > * {
		visibility: hidden;
	}

	.video-embed-accept {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		color: var(--navy-950);
		background: var(--white);
		border: none;
		border-radius: var(--radius-xs);
		padding: 0.7em 1.4em;
		cursor: pointer;
		transition: background var(--dur-fast) var(--ease-out);
	}

	.video-embed-accept:hover {
		background: var(--navy-100);
	}

	.video-embed-external {
		font-size: var(--text-xs);
		color: rgba(255, 255, 255, 0.5);
	}

	.video-embed-external:hover {
		color: rgba(255, 255, 255, 0.8);
	}
</style>
