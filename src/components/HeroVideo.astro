---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { iconSvg } from '../lib/icons';

interface Props {
	hero: CollectionEntry<'hero'>;
	locale?: Locale;
}

const { hero, locale = 'fr' } = Astro.props;
const { title, label, excerpt, videoFile, poster } = hero.data;
const tagline = locale === 'en'
	? 'A new perspective on the Indian Ocean'
	: "Un nouveau regard sur l'océan Indien";
---

<section class="hero-video">
	<div class="hero-media">
		{poster && <img class="hero-poster" src={poster} alt="" fetchpriority="high" />}
		<video
			class="hero-r2"
			src={videoFile}
			poster={poster}
			autoplay
			muted
			loop
			playsinline
			preload="auto"
			aria-hidden="true"
		/>
		<button
			class="hero-play"
			type="button"
			aria-label={locale === 'en' ? 'Play the featured video' : 'Lire la vidéo à la une'}
			hidden
		>
			<Fragment set:html={iconSvg('play', 28)} />
		</button>
	</div>
	<div class="hero-scrim"></div>
	{(title || label || excerpt) && (
		<div class="hero-overlay">
			{label && <span class="hero-label">{label}</span>}
			{title && <h2 class="hero-title">{title}</h2>}
			<p class="hero-tagline">{tagline}</p>
			{excerpt && <p class="hero-excerpt">{excerpt}</p>}
		</div>
	)}
</section>

<script>
	function initHeroVideos() {
		document.querySelectorAll<HTMLElement>('.hero-video').forEach((hero) => {
			if (hero.dataset.videoReady === 'true') return;
			hero.dataset.videoReady = 'true';

			const video = hero.querySelector<HTMLVideoElement>('.hero-r2');
			const poster = hero.querySelector<HTMLImageElement>('.hero-poster');
			const playButton = hero.querySelector<HTMLButtonElement>('.hero-play');
			if (!video || !playButton) return;

			function showPlayingVideo() {
				poster?.classList.add('is-playing');
				playButton!.hidden = true;
			}

			async function startPlayback() {
				video!.muted = true;
				video!.playsInline = true;
				try {
					await video!.play();
					if (!video!.paused && video!.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) showPlayingVideo();
				} catch {
					playButton!.hidden = false;
				}
			}

			video.addEventListener('playing', showPlayingVideo);
			video.addEventListener('canplay', () => void startPlayback(), { once: true });
			playButton.addEventListener('click', () => void startPlayback());

			// The autoplay event can fire before this script runs on fast mobile loads.
			if (!video.paused && video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
				showPlayingVideo();
			} else {
				void startPlayback();
				setTimeout(() => {
					if (video.paused) playButton.hidden = false;
				}, 2000);
			}
		});
	}

	document.addEventListener('astro:page-load', initHeroVideos);
	initHeroVideos();
</script>

<style>
	.hero-video {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-sm);
	}

	.hero-media {
		position: relative;
		height: clamp(420px, 62vh, 640px);
		background: var(--navy-950);
	}

	.hero-poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 2;
		transition: opacity 0.4s ease;
	}

	.hero-poster.is-playing {
		opacity: 0;
		pointer-events: none;
	}

	.hero-r2 {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
	}

	.hero-play {
		position: absolute;
		inset: 50% auto auto 50%;
		z-index: 6;
		display: grid;
		width: 4rem;
		height: 4rem;
		padding: 0 0 0 0.2rem;
		place-items: center;
		transform: translate(-50%, -50%);
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--white);
		color: var(--navy);
		box-shadow: var(--shadow-lg);
		cursor: pointer;
	}

	.hero-play[hidden] {
		display: none;
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		z-index: 4;
		background: linear-gradient(
			to top,
			rgba(20, 26, 63, 0.78) 0%,
			rgba(20, 26, 63, 0.28) 46%,
			rgba(20, 26, 63, 0.10) 100%
		);
		pointer-events: none;
	}

	.hero-overlay {
		position: absolute;
		left: clamp(1.5rem, 4vw, 3rem);
		right: clamp(1.5rem, 4vw, 3rem);
		bottom: 0;
		z-index: 5;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-bottom: clamp(1.5rem, 4vw, 3rem);
		max-width: 68rem;
	}

	.hero-label {
		display: inline-block;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	.hero-title,
	.hero-tagline {
		font-family: var(--font-display);
		font-weight: var(--fw-medium);
		font-size: clamp(1.15rem, 1.7vw, 1.35rem);
		line-height: var(--leading-snug);
		color: var(--white);
	}

	.hero-excerpt {
		color: rgba(255, 255, 255, 0.9);
		font-size: var(--text-lg);
		line-height: var(--leading-normal);
		max-width: 40rem;
	}

	@media (max-width: 640px) {
		.hero-media {
			height: clamp(320px, 50vh, 420px);
		}

		.hero-excerpt {
			display: none;
		}
	}
</style>
