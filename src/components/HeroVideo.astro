---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';

interface Props {
	hero: CollectionEntry<'hero'>;
	locale?: Locale;
}

const { hero, locale = 'fr' } = Astro.props;
const { title, label, excerpt, videoFile, poster } = hero.data;
const tagline = locale === 'en'
	? 'A new perspective on the Indian Ocean'
	: "Un nouveau regard sur l'océan Indien";
---

<section class="hero-video">
	<div class="hero-media">
		{thumbnail && <img class="hero-poster" src={thumbnail} alt="" />}
		<div class="hero-iframe-slot"></div>
		<button class="hero-play" type="button" aria-label="Lire la vidéo à la une" hidden>
			<Fragment set:html={iconSvg('play', 28)} />
		</button>
	</div>
	<div class="hero-scrim"></div>
	{(title || label || excerpt) && (
		<div class="hero-overlay">
			{label && <span class="hero-label">{label}</span>}
			{title && <h2 class="hero-title">{title}</h2>}
			<p class="hero-tagline">{tagline}</p>
			{excerpt && <p class="hero-excerpt">{excerpt}</p>}
		</div>
	)}
</section>

<script>
	const video = document.querySelector('.hero-r2') as HTMLVideoElement | null;
	const canvas = document.querySelector('.hero-canvas') as HTMLCanvasElement | null;

		const slot = hero.querySelector<HTMLElement>('.hero-iframe-slot');
		const poster = hero.querySelector<HTMLImageElement>('.hero-poster');
		const playButton = hero.querySelector<HTMLButtonElement>('.hero-play');
		const embedSrc = hero.dataset.embedSrc;
		if (!slot || !embedSrc) return;
		let youtubePlayer: any;

		function showPlayButton() {
			if (playButton && !poster?.classList.contains('loaded')) playButton.hidden = false;
		}

		function showVideo() {
			poster?.classList.add('loaded');
			if (playButton) playButton.hidden = true;
		}

		function injectIframe() {
			if (slot.querySelector('iframe')) return;
			const iframe = document.createElement('iframe');
			iframe.className = 'hero-iframe';
			iframe.src = embedSrc!;
			iframe.title = 'Vidéo Travel-Îles';
			iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
			iframe.allowFullscreen = true;
			slot.appendChild(iframe);

			// Non-YouTube: fade poster on iframe load (no API available)
			if (!embedSrc!.includes('youtube.com') && poster) {
				iframe.addEventListener('load', () => {
					setTimeout(showVideo, 800);
				});
			}

			// Use YouTube IFrame API to hide poster only when playing, and loop on end
			if (embedSrc!.includes('youtube.com')) {
				function attachYTPlayer() {
					youtubePlayer = new (window as any).YT.Player(iframe, {
						events: {
							onReady(event: any) {
								// Mobile browsers only allow reliable inline autoplay when muted.
								event.target.mute();
								event.target.playVideo();
								setTimeout(showPlayButton, 1600);
							},
							onStateChange(event: any) {
								const PLAYING = 1;
								const ENDED = 0;
								if (event.data === PLAYING) {
									showVideo();
								} else if (event.data === ENDED) {
									// Cover end screen with poster instantly, seek & replay
									if (poster) {
										poster.style.transition = 'none';
										poster.style.opacity = '1';
										poster.style.pointerEvents = 'none';
									}
									youtubePlayer.seekTo(0);
									youtubePlayer.playVideo();
									// Fade poster out again once playback resumes
									setTimeout(() => {
										if (poster) {
											poster.style.transition = '';
											poster.style.opacity = '0';
										}
									}, 800);
								}
							},
							onAutoplayBlocked() {
								showPlayButton();
							}
						}
					});
				}

				if ((window as any).YT && (window as any).YT.Player) {
					attachYTPlayer();
				} else {
					const prev = (window as any).onYouTubeIframeAPIReady;
					(window as any).onYouTubeIframeAPIReady = function() {
						if (prev) prev();
						attachYTPlayer();
					};
					if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
						const tag = document.createElement('script');
						tag.src = 'https://www.youtube.com/iframe_api';
						document.head.appendChild(tag);
					}
				}
			}
		}

		playButton?.addEventListener('click', () => {
			if (!youtubePlayer) return;
			youtubePlayer.mute();
			youtubePlayer.playVideo();
		});

		const consent = localStorage.getItem('ti-cookies');
		if (consent === 'accepted') {
			injectIframe();
		} else {
			document.addEventListener('ti:cookies-accepted', () => injectIframe(), { once: true });
		}
	}

	function captureFrame() {
		if (!video || !canvas) return;
		canvas.width = video.videoWidth;
		canvas.height = video.videoHeight;
		canvas.getContext('2d')?.drawImage(video, 0, 0);
		try {
			const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
			sessionStorage.setItem(CACHE_KEY, dataUrl);
		} catch {}
	}

	if (video && canvas) {
		showCached();
		video.addEventListener('seeked', () => {
			captureFrame();
			video.play();
		}, { once: true });
		video.addEventListener('loadeddata', () => {
			video.currentTime = 0.001;
		}, { once: true });
		video.addEventListener('playing', () => {
			canvas.style.opacity = '0';
		}, { once: true });
	}
</script>

<style>
	.hero-video {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-sm);
	}

	.hero-media {
		position: relative;
		height: clamp(420px, 62vh, 640px);
		background: #141a3f;
	}

	.hero-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 2;
		transition: opacity 0.4s ease;
	}

	.hero-r2 {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
	}

	.hero-iframe-slot :global(.hero-iframe) {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 100vw;
		min-width: 100%;
		height: 56.25vw;
		min-height: 100%;
		border: 0;
		pointer-events: none;
		transform: translate(-50%, -50%) scale(1.25);
	}

	.hero-play {
		position: absolute;
		inset: 50% auto auto 50%;
		z-index: 6;
		display: grid;
		width: 4rem;
		height: 4rem;
		padding: 0 0 0 0.2rem;
		place-items: center;
		transform: translate(-50%, -50%);
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--white);
		color: var(--navy);
		box-shadow: var(--shadow-lg);
		cursor: pointer;
	}

	.hero-play[hidden] {
		display: none;
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		z-index: 4;
		background: linear-gradient(
			to top,
			rgba(20, 26, 63, 0.78) 0%,
			rgba(20, 26, 63, 0.28) 46%,
			rgba(20, 26, 63, 0.10) 100%
		);
		pointer-events: none;
	}

	.hero-overlay {
		position: absolute;
		left: clamp(1.5rem, 4vw, 3rem);
		right: clamp(1.5rem, 4vw, 3rem);
		bottom: 0;
		z-index: 5;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-bottom: clamp(1.5rem, 4vw, 3rem);
		max-width: 68rem;
	}

	.hero-label {
		display: inline-block;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	.hero-title,
	.hero-tagline {
		font-family: var(--font-display);
		font-weight: var(--fw-medium);
		font-size: clamp(1.15rem, 1.7vw, 1.35rem);
		line-height: var(--leading-snug);
		color: var(--white);
	}

	.hero-excerpt {
		color: rgba(255, 255, 255, 0.9);
		font-size: var(--text-lg);
		line-height: var(--leading-normal);
		max-width: 40rem;
	}

	@media (max-width: 640px) {
		.hero-media {
			height: clamp(320px, 50vh, 420px);
		}

		.hero-excerpt {
			display: none;
		}
	}
</style>
