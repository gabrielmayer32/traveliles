---
import type { Locale } from '../lib/i18n';
import { iconSvg } from '../lib/icons';
import { getShareTargets, SHARE_LABELS } from '../lib/share';

interface Props {
	url: string;
	title: string;
	image?: string;
	locale?: Locale;
	variant?: 'inline' | 'feature';
}

const { url, title, image, locale = 'fr', variant = 'inline' } = Astro.props;
const l = SHARE_LABELS[locale];
const targets = getShareTargets(url, title, locale, image);
const iconSize = variant === 'feature' ? 20 : 18;
---

<div
	class:list={['share', `share--${variant}`]}
	data-share-url={url}
	data-share-title={title}
	data-share-start={variant === 'inline' ? '' : undefined}
	data-share-end={variant === 'feature' ? '' : undefined}
>
	{variant === 'feature' ? (
		<div class="share-intro">
			<span class="share-eyebrow">{l.share}</span>
			<p class="share-title">{l.featureTitle}</p>
			<p class="share-text">{l.featureText}</p>
		</div>
	) : (
		<span class="share-eyebrow">{l.share}</span>
	)}

	<div class="share-actions">
		<button class="share-native" type="button" data-share-native hidden>
			<Fragment set:html={iconSvg('share', 18)} />
			<span>{l.share}</span>
		</button>
		<ul class="share-list" role="list">
			{targets.map((target) => (
				<li>
					<a
						class="share-btn"
						href={target.href}
						target={target.id === 'email' ? undefined : '_blank'}
						rel="noopener noreferrer"
						data-share-popup={target.popup ? '' : undefined}
						data-network={target.id}
						aria-label={`${l.shareOn} ${target.label}`}
						title={target.label}
					>
						<Fragment set:html={iconSvg(target.icon, iconSize)} />
					</a>
				</li>
			))}
			<li>
				<button class="share-btn share-copy" type="button" data-share-copy data-copied-label={l.copied} aria-label={l.copy} title={l.copy}>
					<span class="icon-default"><Fragment set:html={iconSvg('link', iconSize)} /></span>
					<span class="icon-done"><Fragment set:html={iconSvg('check', iconSize, 2.25)} /></span>
					<span class="share-toast" data-share-status role="status" aria-live="polite"></span>
				</button>
			</li>
		</ul>
	</div>
</div>

<script>
	import { initShare } from '../lib/share-client';
	initShare();
</script>

<style>
	.share {
		--share-size: 2.75rem;
		--share-fg: var(--navy);
		--share-bg: var(--white);
		--share-border: var(--navy-100);
		--share-hover-fg: var(--white);
		--share-hover-bg: var(--navy);
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-5);
	}

	.share-eyebrow {
		font-size: var(--text-2xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--navy);
	}

	.share-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.share-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.share-btn {
		position: relative;
		display: inline-grid;
		place-items: center;
		width: var(--share-size);
		height: var(--share-size);
		border-radius: 50%;
		color: var(--share-fg);
		background: var(--share-bg);
		border: 1px solid var(--share-border);
		cursor: pointer;
		text-decoration: none;
		transition:
			color 0.2s var(--ease-out),
			background 0.2s var(--ease-out),
			border-color 0.2s var(--ease-out),
			transform 0.2s var(--ease-out),
			box-shadow 0.2s var(--ease-out);
	}

	.share-btn:hover,
	.share-btn:focus-visible {
		color: var(--share-hover-fg);
		background: var(--share-hover-bg);
		border-color: var(--share-hover-bg);
		transform: translateY(-2px);
		box-shadow: var(--shadow-card);
	}

	.share-btn:focus-visible,
	.share-native:focus-visible {
		outline: 2px solid var(--navy-500);
		outline-offset: 3px;
	}

	.share-native {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		height: var(--share-size);
		padding: 0 1.25em;
		border-radius: var(--radius-pill);
		border: 0;
		background: var(--navy);
		color: var(--white);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background 0.2s var(--ease-out), transform 0.2s var(--ease-out);
	}

	.share-native[hidden] {
		display: none;
	}

	.share-native:hover {
		background: var(--navy-800);
		transform: translateY(-1px);
	}

	/* Copy feedback */
	.icon-done {
		display: none;
	}

	.share-copy[data-copied] {
		color: var(--share-hover-fg);
		background: var(--share-hover-bg);
		border-color: var(--share-hover-bg);
	}

	.share-copy[data-copied] .icon-default {
		display: none;
	}

	.share-copy[data-copied] .icon-done {
		display: block;
		animation: share-pop 0.35s var(--ease-out);
	}

	.share-toast {
		position: absolute;
		bottom: calc(100% + 0.6rem);
		left: 50%;
		translate: -50% 0;
		white-space: nowrap;
		padding: 0.4em 0.8em;
		border-radius: var(--radius-pill);
		background: var(--navy-950);
		color: var(--white);
		font-size: var(--text-xs);
		font-weight: var(--fw-medium);
		letter-spacing: 0.02em;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s var(--ease-out);
	}

	.share-toast:not(:empty) {
		opacity: 1;
	}

	@keyframes share-pop {
		from { transform: scale(0.4); }
		to { transform: scale(1); }
	}

	/* Inline variant — sits under the title meta */
	.share--inline {
		width: 100%;
	}

	/* On phones the native share sheet replaces the icon row */
	@media (max-width: 640px) {
		.share--inline .share-native:not([hidden]) + .share-list {
			display: none;
		}
	}

	/* Feature variant — navy end-of-story block */
	.share--feature {
		--share-size: 3.25rem;
		--share-fg: var(--white);
		--share-bg: transparent;
		--share-border: rgba(255, 255, 255, 0.35);
		--share-hover-fg: var(--navy);
		--share-hover-bg: var(--white);
		justify-content: space-between;
		gap: var(--space-8);
		margin-top: var(--space-12);
		padding: clamp(var(--space-8), 5vw, var(--space-12));
		background: var(--surface-navy);
		color: var(--text-on-navy);
		border-radius: var(--radius-sm);
	}

	.share--feature .share-eyebrow {
		color: var(--navy-300);
	}

	.share-intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		max-width: 26rem;
	}

	.share-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--white);
	}

	.share-text {
		margin: 0;
		font-size: var(--text-base);
		color: var(--navy-100);
	}

	.share--feature .share-native {
		background: var(--white);
		color: var(--navy);
		height: var(--share-size);
	}

	.share--feature .share-native:hover {
		background: var(--navy-050);
	}

	.share--feature .share-toast {
		background: var(--white);
		color: var(--navy);
	}

	@media (prefers-reduced-motion: reduce) {
		.share-btn,
		.share-native {
			transition: none;
		}
		.share-btn:hover,
		.share-native:hover {
			transform: none;
		}
		.share-copy[data-copied] .icon-done {
			animation: none;
		}
	}
</style>
