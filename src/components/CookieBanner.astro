---
import { t, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const { locale = 'fr' } = Astro.props;
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Consentement cookies" hidden>
	<div class="cookie-inner container-wide">
		<p class="cookie-text">{t('cookies.text', locale)} <a href={locale === 'en' ? '/en/privacy' : '/confidentialite'}>{t('footer.privacy', locale)}</a></p>
		<div class="cookie-actions">
			<button id="cookie-refuse" class="cookie-btn cookie-btn--refuse" type="button">{t('cookies.refuse', locale)}</button>
			<button id="cookie-accept" class="cookie-btn cookie-btn--accept" type="button">{t('cookies.accept', locale)}</button>
		</div>
	</div>
</div>

<script>
	const CONSENT_MAX_AGE_MS = 182 * 24 * 60 * 60 * 1000;

	function storedChoice() {
		try {
			const choice = localStorage.getItem('ti-cookies');
			const date = Number(localStorage.getItem('ti-cookies-date'));
			if (!choice || !date || Date.now() - date > CONSENT_MAX_AGE_MS) return null;
			return choice;
		} catch {
			return null;
		}
	}

	function saveChoice(choice: 'accepted' | 'refused') {
		try {
			localStorage.setItem('ti-cookies', choice);
			localStorage.setItem('ti-cookies-date', String(Date.now()));
			if (choice === 'refused') localStorage.removeItem('ti-video');
		} catch {}
	}

	function disableAnalytics() {
		(window as any)['ga-disable-G-F00X8JTGKK'] = true;
		const host = location.hostname.split('.').slice(-2).join('.');
		document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((name) => name.startsWith('_ga')).forEach((name) => {
			document.cookie = `${name}=; Max-Age=0; path=/`;
			document.cookie = `${name}=; Max-Age=0; path=/; domain=.${host}`;
		});
	}

	function initCookieBanner() {
		const banner = document.getElementById('cookie-banner');
		const acceptBtn = document.getElementById('cookie-accept');
		const refuseBtn = document.getElementById('cookie-refuse');
		if (!banner || !acceptBtn || !refuseBtn) return;

		if (!storedChoice()) banner.hidden = false;

		acceptBtn.addEventListener('click', () => {
			saveChoice('accepted');
			banner.hidden = true;
			document.dispatchEvent(new CustomEvent('ti:cookies-accepted'));
		});

		refuseBtn.addEventListener('click', () => {
			const wasAccepted = storedChoice() === 'accepted';
			saveChoice('refused');
			disableAnalytics();
			banner.hidden = true;
			if (wasAccepted) location.reload();
		});

		document.querySelectorAll<HTMLElement>('[data-cookie-preferences]').forEach((button) => {
			button.addEventListener('click', () => {
				banner.hidden = false;
				refuseBtn.focus();
			});
		});
	}

	document.addEventListener('astro:page-load', initCookieBanner);
	initCookieBanner();
</script>

<style>
	.cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: var(--navy-950);
		color: var(--white);
		padding-block: var(--space-4);
	}

	.cookie-banner[hidden] {
		display: none;
	}

	.cookie-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		flex-wrap: wrap;
	}

	.cookie-text {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.85);
		line-height: var(--leading-normal);
	}

	.cookie-text a {
		color: inherit;
		text-decoration: underline;
	}

	.cookie-actions {
		display: flex;
		gap: var(--space-3);
		flex-shrink: 0;
	}

	.cookie-btn {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border: none;
		border-radius: var(--radius-xs);
		padding: 0.65em 1.2em;
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}

	.cookie-btn--accept {
		background: var(--white);
		color: var(--navy-950);
	}

	.cookie-btn--accept:hover {
		background: var(--navy-100);
	}

	.cookie-btn--refuse {
		background: transparent;
		color: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.25);
	}

	.cookie-btn--refuse:hover {
		color: var(--white);
		border-color: rgba(255, 255, 255, 0.5);
	}
</style>
